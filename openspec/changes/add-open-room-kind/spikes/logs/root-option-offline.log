# offline verification under kio Manual clock (installed on this runtime)
t0 (manual wall) unix=1735689600
now = t0+10s; tokens iat=t0 exp=t0+600; room-mint shape publish alice/** subscribe **

## marker roots: own path, encoded spellings of the own path, and the other kind
root_allowed(~open) = true
  token ~open  path own literal                  -> ADMIT
  token ~open  path own %-encoded marker         -> refuse(Profile("path outside the grant"))
  token ~open  path own double-encoded marker    -> refuse(Profile("path outside the grant"))
  token ~open  path protected same name          -> refuse(Profile("path outside the grant"))
  token ~open  path own + /alice                 -> ADMIT
  token protected path ~open same name           -> refuse(Profile("path outside the grant"))
  token root %7Eopen    at literal ~open path    -> refuse(Profile("path outside the grant"))
root_allowed(@open) = true
  token @open  path own literal                  -> ADMIT
  token @open  path own %-encoded marker         -> refuse(Profile("path outside the grant"))
  token @open  path own double-encoded marker    -> refuse(Profile("path outside the grant"))
  token @open  path protected same name          -> refuse(Profile("path outside the grant"))
  token @open  path own + /alice                 -> ADMIT
  token protected path @open same name           -> refuse(Profile("path outside the grant"))
  token root %40open    at literal @open path    -> refuse(Profile("path outside the grant"))
root_allowed(+open) = true
  token +open  path own literal                  -> ADMIT
  token +open  path own %-encoded marker         -> refuse(Profile("path outside the grant"))
  token +open  path own double-encoded marker    -> refuse(Profile("path outside the grant"))
  token +open  path protected same name          -> refuse(Profile("path outside the grant"))
  token +open  path own + /alice                 -> ADMIT
  token protected path +open same name           -> refuse(Profile("path outside the grant"))
  token root %2Bopen    at literal +open path    -> refuse(Profile("path outside the grant"))

## tenant-wide grant (root t/<owner>, subscribe **, publish **): spans both kinds
  wide token path t/cGfHiC6Kgg3FpFZvgwGcswsCRtp4aBP2fzuXRQPizuN/standup                  -> ADMIT
  wide token path t/cGfHiC6Kgg3FpFZvgwGcswsCRtp4aBP2fzuXRQPizuN/~open/standup            -> ADMIT

## time is controlled through moq-auth verify and relay profile
  now=t0+10   KeySet::verify=ok  assess=ADMIT
  now=t0+600  KeySet::verify=err(token has expired)  assess=refuse(BadToken)
  now=t0+599  KeySet::verify=ok  assess=ADMIT
  iat=t0+60 at now=t0+10: KeySet::verify=ok  assess=refuse(Profile("issued in the future"))
  host clock: KeySet::verify=err(token has expired)  assess=refuse(BadToken)
