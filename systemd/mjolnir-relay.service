[Unit]
Description=Mjolnir edge relay (WebTransport)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# READY=1 is sent only after the certificate, the keys, and the UDP
# listener are up. ExecStartPost then opens the firewall rule.
Type=notify
NotifyAccess=main
TimeoutStartSec=30
User=mjolnir-relay
Group=mjolnir-relay
ExecStart=/usr/local/bin/mjolnir-relay
# '+' runs outside the service sandbox, as root. The process user cannot
# change iptables. A failed start still runs ExecStopPost, which removes
# the rule.
ExecStartPost=+/usr/local/lib/mjolnir-relay/relay-rule.sh add
ExecStopPost=+/usr/local/lib/mjolnir-relay/relay-rule.sh del
EnvironmentFile=/etc/mjolnir-relay/relay.env
RuntimeDirectory=mjolnir-relay
StateDirectory=mjolnir-relay-state
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/mjolnir-relay/tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mjolnir-relay

[Install]
WantedBy=multi-user.target
