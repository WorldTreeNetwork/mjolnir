[Unit]
Description=Mjolnir edge relay (WebTransport)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=mjolnir-relay
Group=mjolnir-relay
ExecStart=/usr/local/bin/mjolnir-relay
EnvironmentFile=-/etc/mjolnir/env
RuntimeDirectory=mjolnir-relay
StateDirectory=mjolnir-relay-state
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/mjolnir-relay/tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mjolnir-relay

[Install]
WantedBy=multi-user.target
