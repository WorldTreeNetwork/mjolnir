# Mjolnir Gateway environment configuration
# Copy to /etc/mjolnir/gateway.env and adjust as needed.

GATEWAY_LISTEN=0.0.0.0:8080
GATEWAY_DOMAIN=vm.worldtree.network
GATEWAY_DEFAULT_PORT=80
GATEWAY_CONNECT_TIMEOUT=15
GATEWAY_RESPONSE_TIMEOUT=30
GATEWAY_POOL_TTL=300
GATEWAY_POOL_MAX=256
RUST_LOG=info

# --- TLS (Phase 1: static cert + SIGHUP reload) ---

# Listen address for TLS. Set to empty to disable the TLS listener (plaintext-only mode).
# Binding to :443 requires AmbientCapabilities=CAP_NET_BIND_SERVICE in the systemd unit.
GATEWAY_TLS_LISTEN=0.0.0.0:443

# PEM-encoded certificate chain (fullchain). Typically provided by certbot.
# Example: /etc/mjolnir/fullchain.pem (symlink to live certbot path).
GATEWAY_TLS_CERT=/etc/mjolnir/fullchain.pem

# PEM-encoded private key. Must be readable by the mjolnir user.
# Example: /etc/mjolnir/privkey.pem
GATEWAY_TLS_KEY=/etc/mjolnir/privkey.pem

# Refuse TLS handshakes if the loaded cert expires within this many seconds.
# Default 86400 (24h) fails the handshake early to trigger loud monitoring alerts
# rather than silently serving a cert that will expire during a connection.
# Set to 0 to disable this safety check (NOT recommended — see Pre-mortem Scenario 3).
GATEWAY_TLS_EXPIRY_FAIL_SECS=86400

# TLS session resumption cache size (number of tickets kept in memory).
# Higher values improve resumption hit rate for fleets with many distinct clients.
# Default 4096 is suitable for ~500 concurrent clients with 8x renegotiation.
GATEWAY_TLS_SESSION_CACHE=4096

# Optional: plaintext :8080 listener behavior.
# Leave GATEWAY_LISTEN set to keep the plaintext listener running alongside TLS
# (useful for internal health checks and emergency fallback).
# Set GATEWAY_LISTEN= (empty) to disable the plaintext listener entirely once TLS is stable.

# --- ACME auto-TLS (Phase 2: in-process certbot replacement) ---
#
# When enabled, the gateway obtains and renews wildcard certs itself via
# ACME DNS-01 against Cloudflare. When disabled, the gateway uses the
# static GATEWAY_TLS_CERT / GATEWAY_TLS_KEY files from Phase 1.
#
# Requires: CLOUDFLARE_API_TOKEN with Zone:DNS:Edit scope on the target zone.

# enabled | disabled. Default disabled (static-cert mode from Phase 1).
GATEWAY_ACME=disabled

# ACME directory URL. Use production for real certs; staging for testing.
# Staging: https://acme-staging-v02.api.letsencrypt.org/directory
# Production: https://acme-v02.api.letsencrypt.org/directory
GATEWAY_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Contact email for the ACME account. Used by LE for expiry warnings.
GATEWAY_ACME_EMAIL=

# Comma-separated list of domains to include in the cert. Supports wildcards.
# Example: *.vm.worldtree.network,vm.worldtree.network
GATEWAY_ACME_DOMAINS=

# Renew this many seconds before expiry. Default 30 days (2592000).
GATEWAY_ACME_RENEW_BEFORE_SECS=2592000

# Cloudflare API token (Zone:DNS:Edit scope). Required if GATEWAY_ACME=enabled.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Do NOT commit an actual token. Leave this commented in the repo template.
# CLOUDFLARE_API_TOKEN=
