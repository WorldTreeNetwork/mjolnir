# Mjolnir Gateway TOML configuration.
# Copy to /etc/mjolnir/gateway.toml. Override path via GATEWAY_CONFIG env var.
#
# When this file exists at gateway startup, TOML is authoritative and
# /etc/mjolnir/gateway.env is ignored. Startup-only mode selection
# (spec Decision 10) — a TOML file appearing later has no effect until
# the next restart. SIGHUP reloads whichever mode was chosen at boot.

# ── Listener addresses ────────────────────────────────────────────────────────
# Both listeners are explicit opt-in. Omitting a key disables that listener;
# empty string also disables. Binding to :80/:443 as an unprivileged user
# requires CAP_NET_BIND_SERVICE on the systemd unit (already set).
listen      = "0.0.0.0:80"
listen_tls  = "0.0.0.0:443"

# ── Proxy behavior ────────────────────────────────────────────────────────────
vm_default_port         = 80    # target port when a VM URL omits -<port>
connect_timeout_secs    = 15    # TCP/Iroh dial timeout (applies to both local + iroh backends)
response_timeout_secs   = 0     # 0 = no timeout. Set low only if all backends are fast.
pool_ttl_secs           = 300   # Iroh connection pool TTL (idle eviction)
pool_max                = 256   # max Iroh connections in pool
pool_probe_timeout_secs = 10    # first-byte probe on pool-hit reuse; 0 = disable

# ── TLS expiry + session cache ────────────────────────────────────────────────
tls_expiry_fail_secs = 86400    # refuse handshakes if cert expires within N secs (24h default)
tls_session_cache    = 4096     # session resumption tickets kept in memory

# ── ACME (Let's Encrypt DNS-01 via Cloudflare) ────────────────────────────────
# Only Cloudflare DNS-01 is supported in this iteration (spec Decision 2).
# When [acme].enabled = true, the gateway obtains + renews its own certs.
# When disabled, use the [tls] static-cert path below.
[acme]
enabled            = true
email              = "duke@worldtree.io"
directory          = "https://acme-v02.api.letsencrypt.org/directory"
renew_before_secs  = 2592000                                  # 30 days
# One-line token; whitespace stripped. Never commit the actual token to git.
# Falls back to CLOUDFLARE_API_TOKEN env var if this is unset.
cloudflare_api_token_file = "/etc/mjolnir/cloudflare-token"
# Optional: explicit SAN override. Usually leave unset — the SAN list is
# auto-derived per [[domain]] (see spec Decision 7). Only set if you need
# a cert shape the auto-derivation can't express.
# domains = ["*.vm.worldtree.network", "vm.worldtree.network", "git.worldtree.network"]

# ── Static TLS cert (only when [acme].enabled = false) ────────────────────────
# [tls]
# cert = "/etc/mjolnir/fullchain.pem"
# key  = "/etc/mjolnir/privkey.pem"

# ── Apex declarations ─────────────────────────────────────────────────────────
# Each [[domain]] is an apex the gateway will accept requests for.
# fallthrough controls what happens when no explicit [[route]] matches.

# VM-fanout apex: every subdomain is an Iroh z32 node ID unless pinned by a
# [[route]] below. Cert SAN auto-derives to {*.vm.worldtree.network, vm.worldtree.network}.
[[domain]]
suffix      = "vm.worldtree.network"
fallthrough = "iroh"    # optional; this is the default

# Hand-curated apex: only explicit [[route]] entries serve. Unmatched
# subdomains return 404 with no Iroh decode attempt. Cert SAN auto-derives
# to {worldtree.network, <each route subdomain>.worldtree.network} — NO
# wildcard, reducing attack surface and enumeration leakage (spec Decision 7).
[[domain]]
suffix      = "worldtree.network"
fallthrough = "none"

# Parking apex: unmatched names (and the bare apex) serve the berth page.
# Binding a name is an [[alias]] to the VM's Iroh node ID — NAT-reachable,
# and the local [[route]] generator still overlays TAP-IP when the VM is
# on this host. Cert SAN auto-derives to {*.identikey.me, identikey.me}.
[[domain]]
suffix      = "identikey.me"
fallthrough = "parked"

# ── Local-backend routes ──────────────────────────────────────────────────────
# Pin a (apex, subdomain) pair to a local TCP endpoint. Takes precedence
# over the Iroh decode path. Subdomain strings are lowercased at load;
# matching is case-insensitive.
#
# Host is preserved. X-Forwarded-Proto is set to https on the TLS listener
# (http on :80) so backends that emit Secure session cookies actually Set-Cookie.
[[route]]
apex      = "worldtree.network"
subdomain = "git"
backend   = "127.0.0.1:3000"

# IPv6 backends are supported:
# [[route]]
# apex      = "worldtree.network"
# subdomain = "api"
# backend   = "[::1]:8080"

# ── Vanity aliases (friendly subdomain → Iroh node) ───────────────────────────
# Pin a (apex, subdomain) pair to a specific Iroh node ID. Unlike a [[route]]
# (which dials a local TCP backend), an [[alias]] tunnels over Iroh exactly as
# if the request had arrived for "<node>.<iroh-apex>". This is the durable way
# to give a live VM a friendly name: the node ID travels with the VM's identity,
# so the alias survives respawns (a TAP-IP pin would not).
#
# Resolves under ANY apex regardless of `fallthrough`: a `none` apex still
# serves its declared aliases (the alias short-circuits the 404), and the alias
# FQDN is auto-added to the cert SAN list so ACME issues a cert for it.
#
#   node = z32 node ID (the VM's `mj info <id>` ticket, 52 chars)
#   port = optional target port inside the VM (omitted → vm_default_port)
#
# [[alias]]
# apex      = "identikey.io"   # must also be declared as a [[domain]]
# subdomain = "zine"
# node      = "xebksroiithey6dp4q3fwx4ddb6m3c71tjt79bfqy7nktsp76njo"
# port      = 3000

# ── Bring-your-own TLS certs ([[cert]], SNI multi-cert serving) ────────────────
# Serve a per-host certificate selected by the TLS ClientHello's SNI, falling
# back to the primary cert (the ACME-managed wildcard above, or the [tls] static
# cert) when no [[cert]] host matches. This lets you front any hostname pointed
# at the gateway WITHOUT the gateway holding a Cloudflare API token for that
# host's DNS zone — useful for one-off domains in zones you don't control.
#
#   host = the exact SNI hostname this cert serves (lowercased; matched against
#          the ClientHello SNI). Must be a bare FQDN (no wildcard).
#   cert = path to the PEM fullchain (leaf + intermediates).
#   key  = path to the PEM private key.
#
# Cert/key files do NOT need to exist when the gateway starts — drop them in
# later and send SIGHUP (`systemctl reload mjolnir-gateway`) to hot-load them.
# A missing or unparseable file is warn-and-skipped; it never crashes startup.
#
# How to obtain a cert for a host whose DNS you control but the gateway doesn't:
# run the built-in manual DNS-01 issuer on any machine, then copy the output
# files to the paths below:
#
#   mjolnir-gateway cert issue --manual \
#     --domain zine.identikey.io \
#     --email you@example.com \
#     --out /etc/mjolnir/certs/zine
#   # (add --staging while testing to use Let's Encrypt staging)
#
# It prints the _acme-challenge TXT records to create, waits for you to press
# Enter once DNS is live, then writes fullchain.pem + privkey.pem to --out.
#
# [[cert]]
# host = "zine.identikey.io"
# cert = "/etc/mjolnir/certs/zine/fullchain.pem"
# key  = "/etc/mjolnir/certs/zine/privkey.pem"
