# /etc/mjolnir/blob-door.env — door process only.
# Never inject this file into Taskmaster or a guest.

# Overlay bind so TAP guests can reach the door (same IP as tenant Postgres).
# Binary refuses a non-loopback bind unless ALLOW_NONLOCAL=1.
# Never 0.0.0.0. Fail closed if 10.200.0.1 is not assigned on dummy-mjolnir.
BLOB_DOOR_BIND=10.200.0.1:7222
BLOB_DOOR_ALLOW_NONLOCAL=1
BLOB_DOOR_BACKEND=b2
# Safety rail (1 TiB). Disk is the real cap; ENOSPC → 507.
BLOB_DOOR_MAX_BYTES=1099511627776
BLOB_DOOR_CACHE_DIR=/var/lib/mjolnir/btrfs/@blobs
# Working-set budget (64 GiB). Not the archive.
BLOB_DOOR_CACHE_BYTES=68719476736

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Application key: read/write this bucket. Do not grant delete to this key.
# Turn versioning on for the bucket out of band.
