# /etc/mjolnir/blob-door.env — door process only. Never inject into Taskmaster.

BLOB_DOOR_BIND=127.0.0.1:7222
BLOB_DOOR_BACKEND=b2
BLOB_DOOR_MAX_BYTES=67108864

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Application key: read/write this bucket. Do not grant delete to this key.
# Turn versioning on for the bucket out of band.
