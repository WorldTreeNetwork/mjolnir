[Unit]
Description=Mjolnir blob door (recrypt layout on B2)
After=network.target
Documentation=docs/runbooks/blob-door.md

[Service]
Type=exec
# Root: same as mjolnir.service. Overlay bind needs no extra caps.
# Do not source EnvironmentFile into Taskmaster or a guest.
WorkingDirectory=/opt/mjolnir
ExecStart=/opt/mjolnir/bin/mjolnir-blob-door
EnvironmentFile=/etc/mjolnir/blob-door.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
# Disk cache / incoming sink. Outside btrfs_root — a cache on the data
# volume would be CoW-pinned by every snapshot and fill the disk.
# ProtectSystem=strict makes /var read-only without this.
# The installer writes a cache-path.conf override when a custom resolved
# BLOB_DOOR_CACHE_DIR is selected.
ReadWritePaths=/var/lib/mjolnir/blobs
Restart=on-failure

[Install]
WantedBy=multi-user.target
