[Unit]
Description=Mjolnir blob door (recrypt layout on B2)
After=network.target
Documentation=docs/runbooks/blob-door.md

[Service]
Type=exec
# Root: same as mjolnir.service. Overlay bind needs no extra caps.
# Do not source EnvironmentFile into Taskmaster or a guest.
WorkingDirectory=/opt/mjolnir
ExecStart=/opt/mjolnir/bin/mjolnir-blob-door
EnvironmentFile=/etc/mjolnir/blob-door.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
# Disk cache / incoming sink. ProtectSystem=strict makes /var read-only
# without this. Install script creates the subvolume before first start.
ReadWritePaths=/var/lib/mjolnir/btrfs/@blobs
Restart=on-failure

[Install]
WantedBy=multi-user.target
