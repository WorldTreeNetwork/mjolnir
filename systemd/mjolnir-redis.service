[Unit]
Description=Mjolnir Redis sidecar (overlay 10.200.0.1:6379)
After=network.target
Documentation=docs/runbooks/host-redis.md

[Service]
Type=notify
User=redis
Group=redis
ExecStartPre=/usr/bin/bash -c 'ip addr show dummy-mjolnir | grep -q "inet 10.200.0.1/32"'
ExecStart=/usr/bin/redis-server /etc/mjolnir/redis.conf
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/var/lib/mjolnir/redis /run/mjolnir-redis
RuntimeDirectory=mjolnir-redis
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
