[Unit]
Description=Mjolnir Web Gateway (HTTP to Iroh bridge)
After=network-online.target mjolnir.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=mjolnir
Group=mjolnir

ExecStart=/usr/local/bin/mjolnir-gateway

EnvironmentFile=-/etc/mjolnir/gateway.env

# CAP_NET_BIND_SERVICE needed for :80 and :443 binding as unprivileged mjolnir user
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=mjolnir-gateway

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mjolnir-gateway

LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
