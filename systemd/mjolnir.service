[Unit]
Description=Mjolnir MicroVM Fabric
After=network.target local-fs.target
Requires=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=/opt/mjolnir

ExecStart=/opt/mjolnir/_build/prod/rel/mjolnir/bin/mjolnir start
ExecStop=/opt/mjolnir/_build/prod/rel/mjolnir/bin/mjolnir stop

EnvironmentFile=/etc/mjolnir/env

# --- Filesystem hardening ---
# strict: /usr, /boot, /efi read-only; only ReadWritePaths are writable
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mjolnir /etc/mjolnir /etc/systemd/system /tmp/mjolnir /var/run/mjolnir /var/log/mjolnir

# --- Process constraints ---
# NoNewPrivileges off: postgres sidecar uses setpriv --reuid to drop to mjolnir_pg
NoNewPrivileges=no
# PrivateTmp off: UDS sockets in /tmp/mjolnir shared with CH/virtiofsd child processes
PrivateTmp=no
# PrivateMounts off: virtiofsd shares host BTRFS mounts with guest VMs
PrivateMounts=no

# --- Kernel protections ---
# Off: health checks run modprobe kvm/vhost_vsock and sysctl ip_forward at boot
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectControlGroups=true

# --- Device access ---
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw

# --- Resource limits ---
RuntimeDirectory=mjolnir
RuntimeDirectoryMode=0750
LimitNOFILE=65536

# --- Lifecycle ---
# Kill the entire cgroup (VMs, virtiofsd, all child processes) on service stop
KillMode=control-group
TimeoutStopSec=30

# Restart on ANY exit. Mjolnir.Reconcile rehydrates VMs from StateStore on boot.
# StartLimitBurst caps restart rate (5 per 60s); beyond that systemd alerts.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mjolnir

[Install]
WantedBy=multi-user.target
