[Unit]
Description=Mjolnir MicroVM Fabric
After=network.target local-fs.target mjolnir-loopback.service
Requires=local-fs.target
Wants=mjolnir-loopback.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=mjolnir
Group=mjolnir
WorkingDirectory=/opt/mjolnir

ExecStart=/opt/mjolnir/_build/prod/rel/mjolnir/bin/mjolnir start
ExecStop=/opt/mjolnir/_build/prod/rel/mjolnir/bin/mjolnir stop

EnvironmentFile=/etc/mjolnir/env

# CAP_NET_ADMIN: TAP interfaces, ip-route, nftables
# CAP_SYS_ADMIN: BTRFS subvolume create/snapshot/delete
# /dev/kvm and /dev/net/tun are 0666 — no caps needed for those
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
ReadWritePaths=/var/lib/mjolnir /etc/mjolnir

RuntimeDirectory=mjolnir
RuntimeDirectoryMode=0750

# Allow KVM and TUN explicitly (belt-and-suspenders alongside filesystem perms)
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw

# Kill the entire cgroup (VMs, virtiofsd, all child processes) on service stop
KillMode=control-group
TimeoutStopSec=30

# Restart on ANY exit (including clean Type=exec stops and SIGKILL). This is
# the durability contract: if BEAM dies for any reason, systemd brings it
# back, and Mjolnir.Reconcile rehydrates VMs from /var/lib/mjolnir/state.
# StartLimitBurst above still caps the restart rate (5 per 60s); if that
# ceiling is hit, systemd gives up and alerts instead of flapping.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mjolnir

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
