# Mjolnir Runtime Configuration
# Loaded by systemd as EnvironmentFile for mjolnir.service
#
# These override values compiled into the release (config/prod.exs + config/runtime.exs)

# Required for Erlang distribution (remote IEx shell via bin/mjolnir remote)
RELEASE_DISTRIBUTION=name
RELEASE_NODE=mjolnir@127.0.0.1
RELEASE_COOKIE=mjolnir_prod_changeme

# Uncomment to override compiled defaults:
# MJOLNIR_BTRFS_ROOT=/var/lib/mjolnir/btrfs
# MJOLNIR_SOCKET_DIR=/tmp/mjolnir
# MJOLNIR_API_PORT=4000
# MJOLNIR_GUEST_AGENT_BIN=/opt/mjolnir/native/target/x86_64-unknown-linux-musl/release/mjolnir-agent
# MJOLNIR_AUTH_ISSUER=https://connect.identikey.io/realms/identikey
# MJOLNIR_AUTH_AUDIENCE=mjolnir
MJOLNIR_AUTH_BYPASS_LOCALHOST=true
